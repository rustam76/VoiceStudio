# OmniVoice Docker Ignore

# Virtual environments
.venv/
venv/
env/

# Node modules
node_modules/
bun.lockb
.turbo/

# Python caches
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.ruff_cache/
.mypy_cache/

# Databases and user data 
# We don't want to copy existing local data into the image layout!
*.db
*.sqlite
*.sqlite3
omnivoice_data/
frontend/dist/
electron/out/
electron/release/

# Git internals
.git/
.github/

# IDE files
.DS_Store
.vscode/
.idea/

# Online deployment: never send secrets, mobile toolchains or desktop bundles.
.env
.env.*
!.env.example
**/node_modules/
**/.venv/
.agents/
.claude/
.codex/
mobile/
native/
store/
snap/
notebooks/
omnivoice-gallery/
electron/src/main/
electron/src/preload/
**/huggingface/
**/*.onnx
**/*.safetensors
**/*.gguf
**/*.pt
**/*.pth
