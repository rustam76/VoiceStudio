{
  "name": "omnivoice-studio-monorepo",
  "version": "0.5.7",
  "license": "AGPL-3.0-only",
  "private": true,
  "packageManager": "bun@1.4.2",
  "scripts": {
    "setup:api": "node scripts/setup-api.mjs",
    "dev:api": "PYTHONPATH=backend python -m uvicorn online:app --host 127.0.0.1 --port 3900 --workers 1",
    "dev:frontend": "VOICESTUDIO_ONLINE_BUILD=1 bun run --cwd electron dev:web",
    "wait:api": "node scripts/wait-app-port.mjs api",
    "wait:frontend": "node scripts/wait-app-port.mjs web",
    "predev": "node scripts/prepare-dev.mjs",
    "dev": "bun run dev:web",
    "build": "bun run build:web",
    "test:frontend": "node --test tests/frontend/*.test.mjs",
    "deps:check": "taze -r --maturity-period 7",
    "dev:web": "concurrently --kill-others-on-fail \"bun run dev:api\" \"bun run dev:frontend\"",
    "predev:web": "bun install && bun scripts/clear-dev-ports.mjs",
    "build:web": "VOICESTUDIO_ONLINE_BUILD=1 bun run --cwd electron build:web",
    "test": "bun run --cwd electron test",
    "typecheck": "bun run --cwd electron typecheck",
    "lint": "bun run --cwd electron lint",
    "format": "bun run --cwd electron format"
  },
  "workspaces": [
    "electron"
  ],
  "devDependencies": {
    "concurrently": "^10.0.6",
    "playwright": "^1.64.1",
    "taze": "^21.3.0",
    "wait-on": "^9.5.1"
  }
}
