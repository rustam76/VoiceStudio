{
  "name": "omnivoice-studio-monorepo",
  "version": "0.5.8-beta.3",
  "license": "AGPL-3.0-only",
  "private": true,
  "packageManager": "bun@1.4.2",
  "scripts": {
    "setup:api": "node scripts/setup-api.mjs",
    "dev:api": "node scripts/dev-api.mjs",
    "dev:frontend": "bun run --cwd frontend dev:web",
    "wait:api": "node scripts/wait-app-port.mjs api",
    "wait:frontend": "node scripts/wait-app-port.mjs web",
    "dev": "bun run dev:web",
    "predev": "node scripts/prepare-dev.mjs",
    "dev:web": "concurrently --kill-others-on-fail \"bun run dev:api\" \"bun run dev:frontend\"",
    "build": "bun run build:web",
    "build:web": "bun run --cwd frontend build:web",
    "test:frontend": "node --test tests/frontend/*.test.mjs",
    "test": "bun run --cwd frontend test",
    "typecheck": "bun run --cwd frontend typecheck",
    "lint": "bun run --cwd frontend lint",
    "format": "bun run --cwd frontend format",
    "deps:check": "taze -r --maturity-period 7"
  },
  "workspaces": [
    "frontend"
  ],
  "devDependencies": {
    "concurrently": "^10.0.6",
    "playwright": "^1.64.1",
    "taze": "^21.3.0",
    "wait-on": "^9.5.1"
  }
}
